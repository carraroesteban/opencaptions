# Hosted test instances (testers.sh). Copy to .env on the server.
# Testers get https://<name>.<DOMAIN>: point a wildcard DNS record (*.<DOMAIN>) to this server's IP.
DOMAIN=try.example.com
# Your Gemini key: every tester uses it, up to BUDGET_USD_WEEK each (estimated by the app, renewed on Mondays, UTC).
GEMINI_API_KEY=
BUDGET_USD_WEEK=3
# Agenda times are read in this time zone.
TZ=America/Argentina/Buenos_Aires
