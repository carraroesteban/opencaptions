# Get a key (free tier available) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-live-translate-preview

# Public URL used in QR codes (e.g. https://subs.nerdearla.com). Defaults to the request host.
# PUBLIC_URL=

# Protect ingest and the production dashboard (recommended in production)
# INGEST_TOKEN=change-me
# ADMIN_TOKEN=change-me

# PORT=8080
# SILENCE_GATE_SEC=30     # stop streaming to the model after N s of silence (no cost)
# IDLE_CLOSE_SEC=300      # close model sessions after N s without speech
# SPEECH_RMS=0.012        # speech detection threshold (0..1)
# TRANSCRIPTION_MODE=     # '' (verbatim) or SMART (removes filler words)
# STAGES=main:Principal:auto:es+en,sala2:Sala 2:en:es   # override stages (useful to shard across hosts)
# ENGINE=mock             # force simulated captions
# TRANSLATION_MODE=text   # text (default) | live | hybrid — see README
# TEXT_MODEL=gemini-3.5-flash-lite
# MT_RPM=0               # text-translation requests/min budget for the whole server (0 = unlimited; free tier: set your AI Studio limit)
# MT_PARTIAL_MS=1500      # how often the sentence in progress is re-translated as a provisional caption
