# OpenCaptions configuration. Copy to .env and fill in. Full reference: docs/reference/configuration.md

# --- AI provider ------------------------------------------------------------------------------------
# Gemini Developer API key (https://aistudio.google.com/apikey). Without a key the server runs in mock mode.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-live-translate-preview
# TEXT_MODEL=gemini-3.5-flash-lite
# Enterprise: Google Cloud Vertex AI instead of an API key (Application Default Credentials)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Server & network -------------------------------------------------------------------------------
# PORT=8080
# HOST=0.0.0.0              # 127.0.0.1 = only this machine can connect
# PUBLIC_URL=               # e.g. https://subs.example.com — used in QR codes and links
# HTTPS_CERT=./cert.pem     # serve HTTPS directly (e.g. mkcert); or put a TLS proxy / tunnel in front
# HTTPS_KEY=./key.pem
# TRUST_PROXY=loopback      # which proxies' X-Forwarded-* headers to trust (Express syntax)

# --- Security (docs/security-guide.md) --------------------------------------------------------------------
# AUTH=auto                 # auto: this machine is trusted, other devices need a token
#                           # token: token required everywhere · off: no auth (lab only!)
# If unset, random tokens are generated once and stored in data/secrets.json (printed at startup).
# ADMIN_TOKEN=              # dashboard + admin API (use 32+ random chars: openssl rand -base64 24)
# INGEST_TOKEN=             # who may send audio to a room
# ALLOWED_ORIGINS=          # extra web origins allowed to open admin/ingest sockets (comma-separated)
# FRAME_ANCESTORS='self'    # who may embed the pages in an <iframe> (CSP frame-ancestors)
# PULL_ALLOW_PRIVATE=0      # 1 = allow http(s) audio pulls from LAN/private addresses
# MEDIA_DIR=                # extra folder(s) the server may read local audio files from (besides samples/)
# PUBLIC_TRANSCRIPTS=current  # current: audience can download the talk in progress · all · none (admin only)
# MAX_STAGES=60
# MAX_VIEWERS=5000
# RATE_LIMIT_API=300        # state-changing API calls per minute per client IP
# RATE_LIMIT_AUTH_FAIL=20   # failed logins per 10 minutes per client IP before 429
# RATE_LIMIT_WS=3000        # WebSocket connections per minute per client IP (venue Wi-Fi shares one IP!)

# --- Translation & latency (docs/latency.md) --------------------------------------------------------
# TRANSLATION_MODE=text     # text (default) | live | hybrid
# MT_RPM=0                  # text-translation requests/min for the whole server (0 = unlimited)
# MT_PARTIAL_MS=1500        # how often the sentence in progress is re-translated (lower = faster, more requests)
# MT_TIMEOUT_MS=5000
# VAD_SILENCE_MS=0          # e.g. 300: shorter end-of-speech wait in the model (0 = model default)
# TRANSCRIPTION_MODE=       # '' (model default) | VERBATIM | SMART (removes filler words)
# USE_INTERIM=0

# --- Audience AI: "What did I miss?" summaries and "Ask the talk" (docs/security-guide.md#audience-ai) ----
# AUDIENCE_AI=on            # off = no model calls; the audience gets transcript highlights instead
# ASK_RPM=30                # questions/min for the whole server
# ASK_PER_CLIENT_PER_MIN=6  # questions/min per client IP
# SUMMARY_RPM=30            # summary generations/min (results are cached and shared by all viewers)

# --- Agenda (automatic talk titles) -----------------------------------------------------------------
# SCHEDULE=config/schedule.json   # written by Dashboard → 📅 Agenda; see config/schedule.example.csv

# --- Audio & sessions -------------------------------------------------------------------------------
# SILENCE_GATE_SEC=30       # stop streaming to the model after N s of silence (no cost)
# IDLE_CLOSE_SEC=300        # close model sessions after N s without speech
# SPEECH_RMS=0.012          # speech detection threshold (0..1)
# STAGES=main:Principal:auto:es+en,sala2:Sala 2:en:es   # override rooms (useful to shard across hosts)
# ENGINE=mock               # mock = simulated captions · gemini = force the real engine
# EVENT_CONFIG=config/event.json
# FFMPEG_PATH=              # custom ffmpeg binary

# --- Data governance --------------------------------------------------------------------------------
# DATA_DIR=data
# STORE_TRANSCRIPTS=true    # false = captions are only streamed, never written to disk
# RETENTION_DAYS=0          # delete stored transcripts older than N days (0 = keep)

# --- Scripts & debugging ---------------------------------------------------------------------------
# OC_SERVER=http://localhost:8080   # default server for npm run feed / agent / multi
# OC_DEBUG_RAW=0            # 1 = log raw Gemini Live messages

# --- Docker Compose only ----------------------------------------------------------------------------
# BIND_ADDR=127.0.0.1       # 0.0.0.0 to publish the container on the LAN
# WITH_YTDLP=0              # 1 = include yt-dlp in the image (YouTube demos / latency tests)
# TUNNEL_TOKEN=             # Cloudflare Tunnel token for `docker compose --profile tunnel up`
