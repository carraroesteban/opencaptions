{
  // Type checking for plain JavaScript (`npm run typecheck`): JSDoc types, no build step, nothing emitted.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "scripts/**/*.js"]
}
