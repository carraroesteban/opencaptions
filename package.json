{
  "name": "opencaptions",
  "version": "0.1.0",
  "description": "Open-source live captions, translation and 'what did I miss?' summaries for multi-room conferences, powered by Gemini Live Translate and Flash-Lite.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "mock": "node src/server.js --mock",
    "check": "node scripts/check-gemini.js",
    "feed": "node scripts/feed.js",
    "loadtest": "node scripts/loadtest.js",
    "test": "node --test test/*.test.js",
    "agent": "node scripts/agent.js",
    "multi": "node scripts/multi-youtube.js",
    "setup": "node scripts/setup.js",
    "subtitle": "node scripts/subtitle.js"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
