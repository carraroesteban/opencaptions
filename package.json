{
  "name": "opencaptions",
  "version": "0.9.1",
  "description": "Open-source live captions and translation for every event: on phones, on the stage screen and in the livestream. Gemini in the cloud, or Whisper and open models on your own computer.",
  "homepage": "https://opencaptions.kvza.ar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carraroesteban/opencaptions.git"
  },
  "bugs": {
    "url": "https://github.com/carraroesteban/opencaptions/issues"
  },
  "keywords": [
    "captions",
    "subtitles",
    "live-captions",
    "translation",
    "accessibility",
    "events",
    "conference",
    "gemini",
    "whisper",
    "speech-to-text"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "start": "node src/server.js",
    "app": "node scripts/start.js",
    "mock": "node src/server.js --mock",
    "check": "node scripts/check-gemini.js",
    "compare-transcribe": "node scripts/compare-transcribe.js",
    "feed": "node scripts/feed.js",
    "loadtest": "node scripts/loadtest.js",
    "test": "node scripts/run-tests.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "record": "node scripts/record-e2e.js",
    "agent": "node scripts/agent.js",
    "multi": "node scripts/multi-youtube.js",
    "setup": "node scripts/setup.js",
    "subtitle": "node scripts/subtitle.js",
    "local": "node scripts/local.js",
    "site": "node scripts/site.js --serve",
    "docs:images": "node scripts/render-docs.js",
    "demo:record": "node scripts/record-demo.js",
    "a11y": "node scripts/a11y.js",
    "package": "node scripts/package-desktop.js",
    "icons": "node scripts/make-app-icons.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "compression": "^1.8.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "proxy-addr": "^2.0.8",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "7.0.2"
  }
}
